# eslint-plugin-react-native-a11y so declara peer dep de eslint ate a v8 (nao
# ha versao mais nova - ultima publicada e 3.5.1), mas o eslint.config.js ja
# usa FlatCompat pra fazer funcionar normalmente com eslint 9 (flat config).
# Sem isso, "npm ci"/"npm install" falha com ERESOLVE mesmo a combinacao
# sendo valida na pratica.
legacy-peer-deps=true
